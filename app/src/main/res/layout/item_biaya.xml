<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_variant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Category dot -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_dot_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/tv_kategori"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:fontFamily="@font/poppins_bold"
                android:textColor="@color/primary" />

            <TextView android:id="@+id/tv_keterangan"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:fontFamily="@font/poppins_medium"
                android:textColor="@color/text_primary" />

            <TextView android:id="@+id/tv_tanggal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="11sp" android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_hint" />
        </LinearLayout>

        <TextView android:id="@+id/tv_jumlah"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:fontFamily="@font/poppins_bold"
            android:textColor="@color/danger" android:layout_marginEnd="8dp" />

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@null"
            android:tint="@color/text_hint" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
