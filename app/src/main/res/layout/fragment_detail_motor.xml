<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/primary"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">

                        <TextView android:id="@+id/tv_nama_motor"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="22sp" android:fontFamily="@font/poppins_extrabold"
                            android:textColor="@color/white" />

                        <TextView android:id="@+id/tv_merk"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="13sp" android:fontFamily="@font/poppins_regular"
                            android:textColor="#B3E5FC" android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Status Badge -->
                    <TextView android:id="@+id/tv_status"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="12dp" android:paddingVertical="5dp"
                        android:textSize="12sp" android:fontFamily="@font/poppins_bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <TextView android:id="@+id/tv_tahun"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:fontFamily="@font/poppins_regular"
                        android:textColor="#90CAF9" android:layout_marginEnd="16dp" />
                    <TextView android:id="@+id/tv_warna"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="12sp" android:fontFamily="@font/poppins_regular"
                        android:textColor="#90CAF9" />
                </LinearLayout>

                <TextView android:id="@+id/tv_tanggal_masuk"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="11sp" android:fontFamily="@font/poppins_regular"
                    android:textColor="#64B5F6" android:layout_marginTop="4dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Terjual Info -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_terjual_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/status_terjual_bg"
            android:layout_marginBottom="12dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="16dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Tanggal Terjual"
                    android:fontFamily="@font/poppins_medium" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tv_tanggal_terjual"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold" android:textColor="@color/status_terjual" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ringkasan Keuangan -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/surface"
            android:layout_marginBottom="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Ringkasan Keuangan" android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold" android:textColor="@color/primary"
                    android:paddingBottom="14dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Harga Beli"
                        android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_harga_beli"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Biaya Perbaikan"
                        android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_total_biaya_tambahan"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/danger" android:textSize="13sp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginVertical="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Total Modal (Beli + Biaya)"
                        android:fontFamily="@font/poppins_medium" android:textColor="@color/text_primary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_total_pengeluaran"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Harga Jual"
                        android:fontFamily="@font/poppins_regular" android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_harga_jual"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/success" android:textSize="13sp" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp" app:cardBackgroundColor="@color/surface_variant" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Profit / Rugi"
                            android:fontFamily="@font/poppins_bold" android:textColor="@color/text_primary" android:textSize="14sp" />
                        <TextView android:id="@+id/tv_profit"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="18sp" android:fontFamily="@font/poppins_extrabold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Biaya Perbaikan -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Biaya Perbaikan"
                android:textSize="14sp" android:fontFamily="@font/poppins_bold"
                android:textColor="@color/text_primary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tambah_biaya"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Tambah"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                app:backgroundTint="@color/primary_surface"
                android:textColor="@color/primary"
                app:cornerRadius="18dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_biaya"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginBottom="12dp" />

        <!-- Data Kendaraan -->
        <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
            app:cardCornerRadius="16dp" app:cardBackgroundColor="@color/surface" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Data Kendaraan" android:textSize="14sp"
                    android:fontFamily="@font/poppins_bold" android:textColor="@color/primary"
                    android:paddingBottom="12dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="No. Polisi" android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_nomor_polisi"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="No. Rangka" android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_nomor_rangka"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="6dp">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="No. Mesin" android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_nomor_mesin"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="120dp" android:layout_height="wrap_content"
                        android:text="Catatan" android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/text_secondary" android:textSize="13sp" />
                    <TextView android:id="@+id/tv_catatan"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular" android:textColor="@color/text_primary" android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_jual"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Catat Penjualan"
            android:fontFamily="@font/poppins_bold"
            style="@style/PCM.Button.Primary"
            app:backgroundTint="@color/success"
            android:layout_marginBottom="10dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="20dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Edit" android:fontFamily="@font/poppins_medium"
                style="@style/PCM.Button.Outlined" android:layout_marginEnd="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hapus"
                android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Hapus" android:fontFamily="@font/poppins_medium"
                style="@style/PCM.Button.Primary" app:backgroundTint="@color/danger" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
